<UserControl x:Class="MyPlayer_NET9.Controls.InlineEditText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!--
        Самодостаточный модуль "текст, который правится прямо на месте".
        Обычное состояние — TextBlock (если текста нет, виден приглушённый Placeholder).
        Клик — превращается в поле ввода: Enter или потеря фокуса сохраняют, Esc отменяет.
        Шрифт, цвет и размер берёт у родителя (FontSize / FontWeight / Foreground самого контрола),
        поэтому внешний вид настраивается обычным Style снаружи.
    -->
    <Grid>
        <TextBlock x:Name="Display"
                   TextTrimming="CharacterEllipsis"
                   MouseLeftButtonUp="Display_MouseLeftButtonUp"/>

        <Border x:Name="EditorHost"
                Visibility="Collapsed"
                BorderBrush="#FFE86C2C"
                BorderThickness="0,0,0,2">
            <TextBox x:Name="Editor"
                     MaxLength="60"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     CaretBrush="#FFE86C2C"
                     SelectionBrush="#66E86C2C"
                     FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     KeyDown="Editor_KeyDown"
                     LostKeyboardFocus="Editor_LostKeyboardFocus">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Border>
    </Grid>
</UserControl>
